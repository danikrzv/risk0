{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risk0.local/schemas/analysis-response.schema.json",
  "title": "AnalysisResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph", "scenario_results", "exit_estimate", "recommendation", "analyzed_at"],
  "properties": {
    "graph": { "$ref": "#/$defs/RiskGraph" },
    "scenario_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/ScenarioResult" }
    },
    "exit_estimate": { "$ref": "#/$defs/ExitEstimate" },
    "recommendation": { "$ref": "#/$defs/Recommendation" },
    "analyzed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "NullableDecimalString": {
      "oneOf": [
        { "$ref": "#/$defs/DecimalString" },
        { "type": "null" }
      ]
    },
    "MetricValue": {
      "type": ["string", "boolean", "null"]
    },
    "RiskNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "label", "metrics", "provenance", "freshness", "observed_at"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "node_type": {
          "enum": ["position", "vault", "market", "protocol", "asset", "oracle", "pool", "chain"]
        },
        "label": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/MetricValue" }
        },
        "provenance": { "type": "string", "minLength": 1 },
        "freshness": { "enum": ["fresh", "stale_usable", "expired"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "metric_provenance": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/MetricProvenance" }
        }
      }
    },
    "MetricProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["data", "derived", "assumption"] },
        "source": { "type": "string", "minLength": 1 },
        "fetched_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale_usable", "expired", null] },
        "block_number": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "RiskEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relationship", "exposure_weight"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "relationship": {
          "enum": [
            "allocated_to",
            "lends",
            "borrows",
            "uses_collateral",
            "uses_oracle",
            "backed_by",
            "exits_through",
            "deployed_on"
          ]
        },
        "exposure_weight": { "$ref": "#/$defs/NullableDecimalString" },
        "loss_share": { "$ref": "#/$defs/NullableDecimalString" }
      }
    },
    "RiskGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "generated_at", "completeness_warnings"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/RiskNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/RiskEdge" } },
        "generated_at": { "type": "string", "format": "date-time" },
        "completeness_warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ProbabilityEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "low", "central", "high", "confidence", "horizon_days", "source", "retrieved_at", "freshness", "explanation"],
      "properties": {
        "method": { "enum": ["empirical_rolling_window", "model_estimated_protocol", "structural", "unavailable"] },
        "low": { "$ref": "#/$defs/NullableDecimalString" },
        "central": { "$ref": "#/$defs/NullableDecimalString" },
        "high": { "$ref": "#/$defs/NullableDecimalString" },
        "confidence": { "enum": ["high", "medium", "low", "unavailable"] },
        "horizon_days": { "const": 30 },
        "source": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale_usable", "expired"] },
        "explanation": { "type": "string" }
      }
    },
    "ScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "affected_path", "stressed_values", "hard_triggers", "impact", "impact_components", "probability", "confidence", "explanation"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "affected_path": { "type": "array", "items": { "type": "string" } },
        "stressed_values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/MetricValue" }
        },
        "hard_triggers": { "type": "array", "items": { "type": "string" } },
        "impact": { "$ref": "#/$defs/DecimalString" },
        "impact_components": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/DecimalString" }
        },
        "probability": { "$ref": "#/$defs/ProbabilityEstimate" },
        "confidence": { "enum": ["high", "medium", "low", "unavailable"] },
        "explanation": { "type": "string" }
      }
    },
    "ExitEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withdrawable", "route", "slippage", "fees", "gas", "price_impact", "total_cost", "quote_age_seconds", "quoted_at", "source", "retrieved_at", "freshness", "warnings"],
      "properties": {
        "withdrawable": { "type": "boolean" },
        "route": { "type": "array", "items": { "type": "string" } },
        "slippage": { "$ref": "#/$defs/DecimalString" },
        "fees": { "$ref": "#/$defs/DecimalString" },
        "gas": { "$ref": "#/$defs/DecimalString" },
        "price_impact": { "$ref": "#/$defs/DecimalString" },
        "total_cost": { "$ref": "#/$defs/DecimalString" },
        "quote_age_seconds": { "type": "integer", "minimum": 0 },
        "quote_block": { "type": ["integer", "null"], "minimum": 0 },
        "quoted_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale_usable", "expired"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "expected_loss", "exit_cost", "triggers", "dominant_dependency", "confidence", "explanation"],
      "properties": {
        "decision": { "enum": ["STAY", "EXIT", "UNAVAILABLE"] },
        "expected_loss": { "$ref": "#/$defs/DecimalString" },
        "expected_loss_low": { "$ref": "#/$defs/NullableDecimalString" },
        "expected_loss_high": { "$ref": "#/$defs/NullableDecimalString" },
        "exit_cost": { "$ref": "#/$defs/DecimalString" },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "dominant_dependency": { "type": ["string", "null"] },
        "confidence": { "enum": ["high", "medium", "low", "unavailable"] },
        "explanation": { "type": "string" },
        "break_even": {
          "oneOf": [
            { "$ref": "#/$defs/BreakEven" },
            { "type": "null" }
          ]
        },
        "forgone_yield": {
          "description": "Yield given up over the horizon by exiting, in the position numeraire (zero when the APY is unknown or for a borrower; see carry). EXIT iff expected_loss > exit_cost + forgone_yield, absent hard triggers. Null in older responses.",
          "$ref": "#/$defs/NullableDecimalString"
        },
        "cost_of_exiting": {
          "description": "exit_cost + forgone_yield: the cost the expected loss is compared against. Null in older responses.",
          "$ref": "#/$defs/NullableDecimalString"
        },
        "carry": {
          "oneOf": [
            { "$ref": "#/$defs/Carry" },
            { "type": "null" }
          ]
        }
      }
    },
    "Carry": {
      "description": "The position yield over the decision horizon. Lenders: forgone_yield = amount * apy * horizon_days / 365, assuming exited capital is held idle. unknown: the APY is unavailable, zero is used (biasing toward EXIT) and confidence is lowered. not_applicable: borrower carry is not modelled.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "apy", "apy_source", "horizon_days", "notes"],
      "properties": {
        "status": { "enum": ["known", "unknown", "not_applicable"] },
        "apy": {
          "description": "Annual APY as a fraction (0.045 = 4.5%), net of fees when available.",
          "$ref": "#/$defs/NullableDecimalString"
        },
        "apy_source": { "type": ["string", "null"] },
        "horizon_days": { "type": "integer", "minimum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Probability": {
      "type": "string",
      "pattern": "^(?:0(?:\\.\\d+)?|1(?:\\.0+)?)$"
    },
    "NullableProbability": {
      "oneOf": [
        { "$ref": "#/$defs/Probability" },
        { "type": "null" }
      ]
    },
    "BreakEvenPoint": {
      "description": "With cost_of_exiting = exit_cost + forgone_yield: break_even_probability = cost_of_exiting / impact; decision_flip_probability = (cost_of_exiting - other_expected_loss) / impact; both capped to [0, 1] and null (with reasons) when an input is unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "dependency",
        "impact",
        "other_expected_loss",
        "break_even_probability",
        "decision_flip_probability",
        "current_probability",
        "current_probability_low",
        "current_probability_high",
        "reasons"
      ],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "dependency": { "type": ["string", "null"] },
        "impact": { "$ref": "#/$defs/DecimalString" },
        "other_expected_loss": { "$ref": "#/$defs/NullableDecimalString" },
        "break_even_probability": { "$ref": "#/$defs/NullableProbability" },
        "decision_flip_probability": { "$ref": "#/$defs/NullableProbability" },
        "current_probability": { "$ref": "#/$defs/NullableProbability" },
        "current_probability_low": { "$ref": "#/$defs/NullableProbability" },
        "current_probability_high": { "$ref": "#/$defs/NullableProbability" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BreakEven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability_dependent", "dominant_scenario_id", "exit_cost", "points", "explanation"],
      "properties": {
        "probability_dependent": { "type": "boolean" },
        "dominant_scenario_id": { "type": ["string", "null"] },
        "exit_cost": { "$ref": "#/$defs/NullableDecimalString" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/BreakEvenPoint" } },
        "explanation": { "type": "string" },
        "forgone_yield": { "$ref": "#/$defs/NullableDecimalString" },
        "cost_of_exiting": {
          "description": "exit_cost + forgone_yield, the cost the thresholds use; null in older responses or when the exit cost is unknown.",
          "$ref": "#/$defs/NullableDecimalString"
        }
      }
    }
  }
}
