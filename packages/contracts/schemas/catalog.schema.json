{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risk0.local/schemas/v1/catalog.schema.json",
  "title": "CatalogResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "generated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/HydratedCatalogEntry" }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[Ee][+-]?\\d+)?$"
    },
    "CatalogEntry": {
      "type": "object",
      "required": [
        "entity_id",
        "chain_id",
        "entity_type",
        "address_or_market_id",
        "name",
        "description",
        "provenance",
        "provenance_label",
        "supported",
        "supported_modes",
        "lltv"
      ],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "chain_id": { "const": 1 },
        "entity_type": {
          "enum": ["morpho_vault_v2", "morpho_vault_v1", "morpho_market"]
        },
        "address_or_market_id": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "provenance": {
          "enum": ["verified_belem", "belem_distributed", "representative_proxy"]
        },
        "provenance_label": { "type": "string", "minLength": 1 },
        "supported": { "type": "boolean" },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lender", "borrower"] }
        },
        "lltv": {
          "oneOf": [
            { "type": "string", "pattern": "^(?:0(?:\\.\\d+)?|1(?:\\.0+)?)$" },
            { "type": "null" }
          ]
        }
      }
    },
    "CatalogDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/CatalogEntry" }],
            "unevaluatedProperties": false
          }
        }
      }
    },
    "CatalogMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_symbol",
        "collateral_symbol",
        "total_assets",
        "total_assets_usd",
        "liquidity_assets",
        "liquidity_usd",
        "utilization"
      ],
      "properties": {
        "asset_symbol": { "type": "string", "minLength": 1 },
        "collateral_symbol": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "total_assets": { "$ref": "#/$defs/DecimalString" },
        "total_assets_usd": {
          "oneOf": [{ "$ref": "#/$defs/DecimalString" }, { "type": "null" }]
        },
        "liquidity_assets": { "$ref": "#/$defs/DecimalString" },
        "liquidity_usd": {
          "oneOf": [{ "$ref": "#/$defs/DecimalString" }, { "type": "null" }]
        },
        "utilization": {
          "oneOf": [{ "$ref": "#/$defs/DecimalString" }, { "type": "null" }]
        }
      }
    },
    "HydratedCatalogEntry": {
      "allOf": [{ "$ref": "#/$defs/CatalogEntry" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "analysis_available",
        "availability",
        "metrics",
        "source",
        "fetched_at",
        "freshness",
        "age_seconds",
        "block_number",
        "warnings"
      ],
      "properties": {
        "analysis_available": { "type": "boolean" },
        "availability": {
          "enum": [
            "available",
            "catalog_inactive",
            "not_found",
            "delisted",
            "data_conflict",
            "critical_data_missing",
            "provider_unavailable"
          ]
        },
        "metrics": {
          "oneOf": [{ "$ref": "#/$defs/CatalogMetrics" }, { "type": "null" }]
        },
        "source": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "fetched_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "freshness": {
          "oneOf": [
            { "enum": ["fresh", "stale_usable", "expired"] },
            { "type": "null" }
          ]
        },
        "age_seconds": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "block_number": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
