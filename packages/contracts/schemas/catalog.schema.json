{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risk0.local/schemas/catalog.schema.json",
  "title": "CatalogResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/CatalogEntry" }
    }
  },
  "$defs": {
    "CatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "chain_id",
        "entity_type",
        "address_or_market_id",
        "name",
        "description",
        "provenance",
        "provenance_label",
        "supported",
        "supported_modes",
        "lltv"
      ],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "chain_id": { "const": 1 },
        "entity_type": {
          "enum": ["morpho_vault_v2", "morpho_vault_v1", "morpho_market"]
        },
        "address_or_market_id": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "provenance": {
          "enum": ["verified_belem", "belem_distributed", "representative_proxy"]
        },
        "provenance_label": { "type": "string", "minLength": 1 },
        "supported": { "type": "boolean" },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["lender", "borrower"] }
        },
        "lltv": {
          "oneOf": [
            { "type": "string", "pattern": "^(?:0(?:\\.\\d+)?|1(?:\\.0+)?)$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
